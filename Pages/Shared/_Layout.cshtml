<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - PaperTray</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PaperTray.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav aria-label="Main navigation">
            <div>
                <a asp-area="" asp-page="/Index">PaperTray</a>
                <div>
                    <a asp-area="" asp-page="/Index">Home</a>
                    <a asp-area="" asp-page="/Budget/Index">Budget</a>
                    <a asp-area="" asp-page="/Accounts/Index">Accounts</a>
                    <a asp-area="" asp-page="/Transactions/Index">Transactions</a>
                    <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </div>
        </nav>
    </header>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div>
            &copy; 2026 - PaperTray - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
