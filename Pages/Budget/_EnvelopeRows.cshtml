@model IEnumerable<PaperTray.Models.Envelope>

@foreach (var envelope in Model)
{
    <tr>
        <th scope="row">
            <form method="post" asp-page-handler="RenameEnvelope">
                <input type="hidden" name="id" value="@envelope.Id" />
                <label>
                    <span>Envelope name</span>
                    <input type="text"
                           name="name"
                           value="@envelope.CategoryName"
                           maxlength="100"
                           autocomplete="off" />
                </label>
                <button type="submit">Rename</button>
                @if (!string.IsNullOrEmpty(envelope.RenameError))
                {
                    <span aria-live="polite">@envelope.RenameError</span>
                }
            </form>
        </th>
        <td>
            <form method="post" asp-page-handler="UpdateAllocation">
                <input type="hidden" name="id" value="@envelope.Id" />
                <label>
                    <span>Allocated</span>
                    $<input type="number" name="allocated" value="@envelope.AllocatedAmount" min="0" step="0.01" />
                </label>
                <button type="submit">Update</button>
            </form>
        </td>
        <td>$@envelope.SpentAmount</td>
        <td>$@envelope.Balance</td>
    </tr>
}
