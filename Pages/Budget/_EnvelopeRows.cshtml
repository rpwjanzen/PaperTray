@model IEnumerable<PaperTray.Models.Envelope>

@foreach (var envelope in Model)
{
    <tr data-signals="{ allocated_@envelope.Id: @envelope.AllocatedAmount, spent_@envelope.Id: @envelope.SpentAmount }">
        <th scope="row">
            <form method="post" asp-page-handler="RenameEnvelope">
                <input type="hidden" name="id" value="@envelope.Id" />
                <label>
                    <span>Envelope name</span>
                    <input type="text"
                           name="name"
                           value="@envelope.CategoryName"
                           maxlength="100"
                           autocomplete="off" />
                </label>
                <button type="submit">Rename</button>
                @if (!string.IsNullOrEmpty(envelope.RenameError))
                {
                    <span aria-live="polite">@envelope.RenameError</span>
                }
            </form>
        </th>
        <td>
            <label>
                <span>Allocated</span>
                $<input type="number"
                       data-bind:allocated_@envelope.Id
                       data-on:input__delay.500ms="@@post('/budget/UpdateAllocation?id=@envelope.Id')" />
            </label>
        </td>
        <td>$@envelope.SpentAmount</td>
        <td>$<span data-text="$allocated_@envelope.Id - $spent_@envelope.Id"></span></td>
    </tr>
}
